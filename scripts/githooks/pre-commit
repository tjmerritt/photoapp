#!/usr/bin/env bash
# scripts/githooks/pre-commit — runs the test suite before every commit.
#
# Not installed by default (git doesn't auto-discover hooks outside
# .git/hooks, which isn't tracked). Enable it once per clone with:
#
#   git config core.hooksPath scripts/githooks
#
# Go tests that need a database skip themselves automatically when
# TEST_DATABASE_URL is unset (see internal/testutil's doc comment), so this
# hook still runs fine without one configured — it just won't exercise the
# DB-backed suite. Set TEST_DATABASE_URL in your shell profile to get full
# coverage locally.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: go vet ./..."
go vet ./...

echo "pre-commit: go test ./..."
# -p 1 -count=1: required whenever TEST_DATABASE_URL is set — see
# internal/testutil.TruncateAll's doc comment and the Makefile's test-go
# target. Harmless (just marginally slower / always-fresh) when it isn't.
go test -p 1 -count=1 ./...

if [[ -f package.json ]]; then
    echo "pre-commit: npm test"
    npm test --silent
fi

echo "pre-commit: all checks passed"
